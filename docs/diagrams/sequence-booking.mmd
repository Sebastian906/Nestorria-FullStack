%% Nestorria - Booking sequence (React -> Spring -> DB -> STOMP)
sequenceDiagram
  actor U as Guest
  participant R as React PropertyDetails
  participant S as BookingController
  participant V as BookingService
  participant D as Postgres nestorria
  participant W as STOMP broker
  participant N as NotificationBell
  U->>R: select dates and guests
  R->>S: POST /api/bookings/check-availability
  S->>V: check overlap
  V->>D: overlap query
  D-->>V: free
  V-->>S: available
  S-->>R: 200 available
  R->>S: POST booking
  S->>V: create PENDING
  V->>D: insert Booking
  D-->>V: ok
  S->>W: publish booking created
  W-->>N: push
  S-->>R: 201 MyBookings entry
