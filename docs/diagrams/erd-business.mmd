    string id PK
    string contractType
    string status
    datetime signedByTenantAt
    datetime signedByAgencyAt
    datetime generatedAt
  }
  CONTRACT_CLAUSE {
    string id PK
    string title
    string content
  }
  DIGITAL_SIGNATURE {
    string id PK
    string role
    datetime signedAt
    string ipAddress
    string userAgent
  }
  REVIEW {
    string id PK
    int rating
    string comment
    string originalLang
    boolean isVerified
  }
  FAVORITE {
    string id PK
  }
  NOTIFICATION {
    string id PK
    string type
    string title
    string message
    string referenceType
    string referenceId
    datetime readAt
  }
  USER ||--o{ BOOKING : makes
  AGENCY ||--o{ PROPERTY : owns
  CATEGORY_TREE ||--o{ PROPERTY : classifies
  CATEGORY_TREE ||--o{ CATEGORY_TREE : parent_of
  PROPERTY ||--o{ BOOKING : receives
