%% Nestorria - Backend business ER diagram (verified 2026-09-12)
%% Attributes read from @Entity classes under server/.../modules/*/
%% Verified enums below. ContractType, NotificationType and PropertyType values: TODO verify.
%% Identity comes from Clerk; the app stores the role in users.role (User.java:47-48, default USER).
%% USER-AGENCY cardinality inferred from Agency.owner field: TODO confirm with business rule.
erDiagram
  USER {
    string id PK
    string username
    string email
    string image
  }
  AGENCY {
    string id PK
    string name
    string address
    string contact
    string email
    string city
  }
  PROPERTY {
    string id PK
    string title
    string description
    string city
    string country
    string address
    int area
    string propertyType
    int price_rent
    int price_sale
    float latitude
    float longitude
    string amenities
    string images
    boolean isAvailable
  }
  CATEGORY_TREE {
    int id PK
    string name
    string slug
    string description
  }
  BOOKING {
    string id PK
    date checkInDate
    date checkOutDate
    long totalPrice
    int guests
    string status
    string paymentMethod
    boolean isPaid
  }
  INVOICE {
    string id PK
    string invoiceNumber
    date issueDate
    date dueDate
    string status
    string stripeSessionId
  }
  PAYMENT_TRANSACTION {
    string id PK
    string currency
    string paymentMethod
    string gatewayReference
    string status
    datetime paidAt
    string failureMessage
  }
