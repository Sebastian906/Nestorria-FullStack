# Service configuration
SERVICE_NAME=ai-service
VERSION=0.1.0
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30
LLM_CHAT_RATE_LIMIT=20
LLM_CHAT_RATE_WINDOW=3600
CONVERSATION_TTL=1800
CONVERSATION_MAX_MESSAGES=10

# Optional: database connection (for future use)
# DATABASE_URL=

# Optional: API key for external services (for future use)
# API_KEY=